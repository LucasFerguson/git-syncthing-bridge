# Copy to .env (mode 600).

# Obsidian vault: a git clone that is also the Syncthing folder.
VAULT_PATH=/opt/vault/obsidian-vault
GIT_BRANCH=main

# Syncthing REST API. The API key is read from Syncthing's config.xml
# (/root/.local/state/syncthing/config.xml); set SYNCTHING_API_KEY only to override.
SYNCTHING_API_URL=http://127.0.0.1:8384
SYNCTHING_FOLDER_ID=

# daily     = one commit per calendar day, amended locally, pushed after midnight
# immediate = commit and push after every quiet period
COMMIT_MODE=daily
# Quiet period after Syncthing goes idle before committing (ms)
DEBOUNCE_MS=15000
# How often to fetch from the remote; also a fallback sync trigger (ms)
PULL_INTERVAL_MS=300000

# warn  = alert on .sync-conflict files, keep committing other notes
# block = no commits until every conflict copy is resolved
CONFLICT_POLICY=warn
# Photos and attachments are committed. Files over this size are kept out of
# git (still synced) because GitHub refuses pushes with files over 100 MB.
MAX_FILE_MB=95

# Alerts: an ntfy topic URL, e.g. https://ntfy.sh/<long-random-topic>
# Leave empty to only log.
NOTIFY_URL=
NOTIFY_TOKEN=

# Dashboard: bind to the NetBird address (or 127.0.0.1 + ssh -L). Disabled without a password.
DASHBOARD_HOST=100.71.189.190
DASHBOARD_PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

LOG_LEVEL=info
