# Path to the Obsidian vault git repo (Syncthing folder)
VAULT_PATH=/opt/vault/obsidian-vault

# Syncthing REST API
SYNCTHING_API_URL=http://127.0.0.1:8384
SYNCTHING_API_KEY=your_api_key_here

# Syncthing folder ID for the vault (found in Syncthing UI or config.xml)
SYNCTHING_FOLDER_ID=

# How long to wait after Syncthing goes idle before committing (ms)
DEBOUNCE_MS=15000

# How often to pull from Gitea (ms) — default 5 minutes
PULL_INTERVAL_MS=300000

# Git remote URL for the vault repo
VAULT_REMOTE=git@github.com:youruser/obsidian-vault.git

# Dashboard web UI port
DASHBOARD_PORT=3000
